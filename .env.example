NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose. Used for inviting users and the seed script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (optional until you want notifications). Free tier at resend.com; verify your sending domain.
RESEND_API_KEY=
EMAIL_FROM="Supervision Desk <noreply@yourdomain.com>"
# Any long random string. Vercel sends it to the daily cron job.
CRON_SECRET=
